{
  "ci": {
    "collect": {
      "startServerCommand": "npx astro preview --port 4173",
      "startServerReadyPattern": "localhost:4173",
      "url": [
        "http://localhost:4173/",
        "http://localhost:4173/atlas/",
        "http://localhost:4173/prosedur/botox/",
        "http://localhost:4173/atlas/struktur/arteri-facialis/",
        "http://localhost:4173/teknologi/laser-picosecond/",
        "http://localhost:4173/alat/",
        "http://localhost:4173/cari/",
        "http://localhost:4173/alat/cynosure-picosure/",
        "http://localhost:4173/komplikasi/oklusi-vaskular/",
        "http://localhost:4173/materi/filler-ha/"
      ],
      "numberOfRuns": 1,
      "settings": {
        "preset": "desktop",
        "chromeFlags": "--no-sandbox"
      }
    },
    "assert": {
      "assertMatrix": [
        {
          "matchingUrlPattern": "^(?!.*/cari/).*$",
          "assertions": {
            "categories:accessibility": [
              "error",
              {
                "minScore": 0.95
              }
            ],
            "categories:best-practices": [
              "warn",
              {
                "minScore": 0.9
              }
            ],
            "categories:seo": [
              "warn",
              {
                "minScore": 0.9
              }
            ],
            "categories:performance": [
              "warn",
              {
                "minScore": 0.8
              }
            ]
          }
        },
        {
          "matchingUrlPattern": ".*/cari/$",
          "assertions": {
            "categories:accessibility": [
              "error",
              {
                "minScore": 0.95
              }
            ],
            "categories:best-practices": [
              "warn",
              {
                "minScore": 0.9
              }
            ],
            "categories:performance": [
              "warn",
              {
                "minScore": 0.8
              }
            ]
          }
        }
      ]
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
