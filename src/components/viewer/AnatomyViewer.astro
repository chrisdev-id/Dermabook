---
import { getCollection } from 'astro:content';
import Icon from '../Icon.astro';
import { LAYERS, CAMERA_PRESETS } from '../../lib/viewer/layers';

// Indeks konten untuk viewer: nama mesh dasar → struktur, dan definisi zona bahaya.
const structures = await getCollection('structures');
const structureIndex: Record<string, { slug: string; name: string; latin: string; summary: string; schematic: boolean }> = {};
for (const s of structures) {
  for (const mesh of s.data.meshes) {
    structureIndex[mesh] = {
      slug: s.id,
      name: s.data.name_id,
      latin: s.data.name_latin,
      summary: s.data.summary,
      schematic: s.data.schematic,
    };
  }
}
const zones = (await getCollection('danger-zones')).sort((a, b) => a.data.order - b.data.order);
const zoneData = zones.map((z) => ({
  slug: z.id,
  name: z.data.name,
  summary: z.data.summary,
  risk: z.data.risk_level,
  overlay: z.data.overlay,
}));
---
<div class="anatomy-viewer grid gap-5 lg:grid-cols-[1fr_20rem]" data-viewer>
  <div
    class="relative overflow-hidden rounded-2xl"
    style="background: radial-gradient(90% 80% at 50% 40%, color-mix(in oklab, var(--brand) 14%, var(--bg)) 0%, var(--brand-soft) 60%, var(--surface) 100%);"
  >
    <div class="h-[66vh] min-h-[22rem] w-full touch-none" data-canvas></div>

    <div class="pointer-events-none absolute inset-x-0 top-0 flex p-3">
      <div class="pointer-events-auto flex max-w-full gap-1 overflow-x-auto rounded-xl bg-bg/85 p-1 shadow-sm backdrop-blur [scrollbar-width:none]" role="group" aria-label="Sudut pandang kamera">
        {Object.entries(CAMERA_PRESETS).map(([key, p]) => (
          <button type="button" data-preset={key} aria-pressed="false"
            class="whitespace-nowrap rounded-lg px-2.5 py-1.5 text-xs font-semibold text-muted transition-colors duration-200 hover:bg-surface hover:text-ink aria-pressed:bg-brand-soft aria-pressed:text-brand-ink">
            {p.label}
          </button>
        ))}
      </div>
    </div>

    <p class="absolute inset-0 m-auto hidden h-fit max-w-sm p-4 text-center text-sm text-muted" data-fallback>
      Browser ini tidak mendukung WebGL, jadi model 3D tidak bisa ditampilkan. Coba gunakan versi terbaru Chrome,
      Edge, Firefox, atau Safari.
    </p>
    <p class="absolute bottom-3 left-3 hidden rounded-md bg-ink/80 px-2 py-1 font-mono text-xs text-bg" data-fps></p>
    <p class="absolute bottom-3 right-3 hidden items-center gap-2 rounded-lg bg-bg/90 px-3 py-1.5 text-xs font-medium shadow-sm [&:not(.hidden)]:inline-flex" data-loading>
      <span class="size-3 animate-spin rounded-full border-2 border-brand border-t-transparent motion-reduce:animate-none" aria-hidden="true"></span>
      <span data-loading-text>Memuat model</span>
    </p>
  </div>

  <aside class="space-y-4 text-sm">
    <section class="panel p-5" aria-live="polite" data-info>
      <h2 class="font-bold">Struktur yang dipilih</h2>
      <p class="mt-2 text-muted" data-info-empty>Klik atau ketuk bagian model untuk melihat penjelasannya.</p>
      <div class="mt-2 hidden space-y-1.5" data-info-body>
        <p class="text-base font-bold" data-info-name></p>
        <p class="text-xs italic text-muted" data-info-latin></p>
        <p class="text-xs text-muted" data-info-meta></p>
        <p class="pt-1" data-info-summary></p>
        <div class="flex flex-wrap gap-2 pt-2">
          <a href="#" class="btn btn-secondary btn-sm hidden" data-info-link>Baca selengkapnya <Icon name="arrow-right" size={14} weight="bold" /></a>
          <button type="button" data-isolate class="btn btn-quiet btn-sm">
            <Icon name="selection-foreground" size={14} /> <span data-isolate-text>Tampilkan struktur ini saja</span>
          </button>
        </div>
      </div>
    </section>

    <section class="panel p-5" aria-labelledby="layers-h">
      <h2 id="layers-h" class="font-bold">Lapisan</h2>
      <ul class="mt-3 space-y-1">
        {LAYERS.map((l) => (
          <li class:list={['group rounded-lg py-1.5', !l.available && 'opacity-50']}>
            <label class="flex cursor-pointer items-center gap-2.5">
              <span class="inline-block size-3 shrink-0 rounded-[4px]" style={`background:${l.color}`} aria-hidden="true"></span>
              <span class="flex-1 font-medium">{l.label}</span>
              {!l.available && <span class="text-xs text-muted">segera</span>}
              <input type="checkbox" class="switch" data-layer={l.key} checked={l.visible} disabled={!l.available} />
            </label>
            {l.available && (
              <input type="range" min="0" max="1" step="0.05" value={l.opacity} data-opacity={l.key}
                aria-label={`Transparansi ${l.label}`}
                class="mt-1.5 hidden h-1 w-full accent-brand group-has-[:checked]:block" />
            )}
          </li>
        ))}
      </ul>
    </section>

    <section class="panel p-5" aria-labelledby="zones-h">
      <div class="flex items-center justify-between gap-2">
        <h2 id="zones-h" class="font-bold">Zona bahaya vaskular</h2>
        <label class="flex items-center gap-2 text-xs font-medium text-muted">
          Tampilkan
          <input type="checkbox" class="switch switch-danger" data-zones-toggle />
        </label>
      </div>
      <ul class="mt-3 space-y-0.5">
        {zoneData.map((z) => (
          <li>
            <button type="button" data-zone={z.slug} aria-pressed="false"
              class="flex w-full items-center gap-2.5 rounded-lg px-2 py-1.5 text-left font-medium transition-colors duration-200 hover:bg-surface-2 aria-pressed:bg-danger-soft aria-pressed:text-danger">
              <Icon name={z.risk === 'tinggi' ? 'warning-octagon' : 'warning'} size={16}
                class={z.risk === 'tinggi' ? 'text-danger' : 'text-warning'} />
              <span class="flex-1">{z.name}</span>
            </button>
          </li>
        ))}
      </ul>
      <div class="mt-3 hidden rounded-xl border-l-4 border-danger bg-danger-soft p-3 text-xs text-ink" data-zone-info>
        <p data-zone-summary></p>
        <a href="#" class="mt-2 inline-flex items-center gap-1 font-semibold" data-zone-link>Penjelasan dan sumber <Icon name="arrow-right" size={12} weight="bold" /></a>
      </div>
      <p class="mt-3 text-xs text-muted">Penanda hanya ilustrasi. Letak pembuluh darah berbeda pada tiap orang.</p>
    </section>

    <p class="px-1 text-xs text-muted">
      Model: "BodyParts3D, The Database Center for Life Science, CC-BY-SA 2.1 Japan";
      "Z-Anatomy, The libre 3D atlas of anatomy, CC-BY-SA 4.0". Dimodifikasi oleh Dermabook.id (CC BY-SA 4.0).
      <a href="/kredit/">Kredit</a>.
    </p>
  </aside>
</div>

<script is:inline type="application/json" id="viewer-structures" set:html={JSON.stringify(structureIndex)}></script>
<script is:inline type="application/json" id="viewer-zones" set:html={JSON.stringify(zoneData)}></script>

<script>
  import { AnatomyViewer, type ZoneDef } from '../../lib/viewer/anatomy-viewer';
  import { LAYERS, type CameraPreset, type LayerKey } from '../../lib/viewer/layers';

  type StructureInfo = { slug: string; name: string; latin: string; summary: string; schematic: boolean };
  type ZoneInfo = ZoneDef & { name: string; summary: string; risk: string };

  const root = document.querySelector<HTMLElement>('[data-viewer]')!;
  const q = <T extends Element = HTMLElement>(sel: string) => root.querySelector<T>(sel)!;
  const structures: Record<string, StructureInfo> = JSON.parse(document.getElementById('viewer-structures')!.textContent!);
  const zones: ZoneInfo[] = JSON.parse(document.getElementById('viewer-zones')!.textContent!);
  const bySlug = new Map<string, string[]>();
  for (const [mesh, s] of Object.entries(structures)) bySlug.set(s.slug, [...(bySlug.get(s.slug) ?? []), mesh]);

  if (!AnatomyViewer.isSupported()) {
    q('[data-fallback]').classList.remove('hidden');
  } else {
    const viewer = new AnatomyViewer(q('[data-canvas]'));
    if (import.meta.env.DEV) (window as any).__viewer = viewer; // untuk debugging lokal

    const loadingEl = q('[data-loading]');
    const pending = new Set<string>();
    viewer.onLoading = (layer, on) => {
      on ? pending.add(layer) : pending.delete(layer);
      loadingEl.classList.toggle('hidden', pending.size === 0);
    };

    /** Samakan kontrol lapisan dengan keadaan viewer (setelah fokus/zona mengubahnya). */
    const syncLayerUi = () => {
      for (const l of LAYERS) {
        if (!l.available) continue;
        const s = viewer.layerState(l.key);
        q<HTMLInputElement>(`[data-layer="${l.key}"]`).checked = s.visible;
        q<HTMLInputElement>(`[data-opacity="${l.key}"]`).value = String(s.opacity);
      }
    };

    // ── Info struktur ──
    const sideLabel: Record<string, string> = { l: 'kiri', r: 'kanan' };
    const layerLabel = Object.fromEntries(LAYERS.map((l) => [l.key, l.label]));
    const isolateBtn = q<HTMLButtonElement>('[data-isolate]');
    const infoLink = q<HTMLAnchorElement>('[data-info-link]');
    viewer.onPick = (info) => {
      q('[data-info-empty]').classList.toggle('hidden', !!info);
      q('[data-info-body]').classList.toggle('hidden', !info);
      if (!info) return;
      const s = structures[info.base];
      const rawName = info.sourceName.replace(/\.(l|r)$/, '').replace(/^\((.*)\)$/, '$1');
      q('[data-info-name]').textContent = s?.name ?? rawName;
      q('[data-info-latin]').textContent = s ? s.latin : rawName;
      q('[data-info-meta]').textContent = [
        layerLabel[info.layer],
        info.side && `sisi ${sideLabel[info.side] ?? info.side}`,
        info.schematic ? 'ilustrasi skematik' : 'model Z-Anatomy',
      ].filter(Boolean).join(', ');
      q('[data-info-summary]').textContent = s?.summary ?? 'Penjelasan untuk struktur ini belum tersedia.';
      infoLink.classList.toggle('hidden', !s);
      if (s) infoLink.href = `/atlas/struktur/${s.slug}/`;
    };
    isolateBtn.addEventListener('click', () => {
      const on = viewer.toggleIsolate();
      q('[data-isolate-text]').textContent = on ? 'Tampilkan semua' : 'Tampilkan struktur ini saja';
    });

    // ── Lapisan & kamera ──
    const markPreset = (key: string | null) =>
      root.querySelectorAll<HTMLButtonElement>('[data-preset]').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.preset === key)));
    root.querySelectorAll<HTMLInputElement>('[data-layer]').forEach((cb) =>
      cb.addEventListener('change', () => viewer.setLayerVisible(cb.dataset.layer as LayerKey, cb.checked)),
    );
    root.querySelectorAll<HTMLInputElement>('[data-opacity]').forEach((r) =>
      r.addEventListener('input', () => viewer.setLayerOpacity(r.dataset.opacity as LayerKey, Number(r.value))),
    );
    root.querySelectorAll<HTMLButtonElement>('[data-preset]').forEach((b) =>
      b.addEventListener('click', () => {
        viewer.setPreset(b.dataset.preset as CameraPreset);
        markPreset(b.dataset.preset!);
      }),
    );

    // ── Zona bahaya ──
    const zonesToggle = q<HTMLInputElement>('[data-zones-toggle]');
    const zoneInfo = q('[data-zone-info]');
    const markZone = (slug: string | null) =>
      root.querySelectorAll<HTMLButtonElement>('[data-zone]').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.zone === slug)));
    const showZones = async (on: boolean) => {
      zonesToggle.checked = on;
      await viewer.setZonesVisible(zones, on);
      syncLayerUi();
      if (!on) {
        zoneInfo.classList.add('hidden');
        markZone(null);
      }
    };
    const selectZone = async (slug: string) => {
      const z = zones.find((x) => x.slug === slug);
      if (!z) return;
      await showZones(true);
      viewer.focusZone(slug);
      markPreset(null);
      q('[data-zone-summary]').textContent = z.summary;
      q<HTMLAnchorElement>('[data-zone-link]').href = `/atlas/zona-bahaya/${slug}/`;
      zoneInfo.classList.remove('hidden');
      markZone(slug);
    };
    zonesToggle.addEventListener('change', () => showZones(zonesToggle.checked));
    root.querySelectorAll<HTMLButtonElement>('[data-zone]').forEach((b) =>
      b.addEventListener('click', () => selectZone(b.dataset.zone!)),
    );

    // ?fps=1 menampilkan penghitung FPS untuk uji performa perangkat
    const params = new URLSearchParams(location.search);
    if (params.has('fps')) {
      const fpsEl = q('[data-fps]');
      fpsEl.classList.remove('hidden');
      viewer.onFps = (fps) => (fpsEl.textContent = `${fps.toFixed(0)} fps`);
    }

    viewer
      .init()
      .then(async () => {
        markPreset('depan');
        // Tautan dari halaman lain: ?fokus=<slug-struktur> atau ?zona=<slug-zona>
        const fokus = params.get('fokus');
        const zona = params.get('zona');
        if (fokus && bySlug.has(fokus)) {
          await viewer.focusStructure(bySlug.get(fokus)!);
          markPreset(null);
          syncLayerUi();
        } else if (zona) {
          await selectZone(zona);
        }
      })
      .catch((err) => {
        console.error(err);
        q('[data-loading-text]').textContent = 'Model gagal dimuat.';
        loadingEl.classList.remove('hidden');
      });
  }
</script>
