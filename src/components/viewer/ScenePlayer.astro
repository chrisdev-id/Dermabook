---
// Mode presentasi: viewer 3D + narasi bertahap (bahasa awam) + QR ke materi pasien.
import { getCollection } from 'astro:content';
import Icon from '../Icon.astro';

interface Props {
  title: string;
  scenes: { title: string; narration: string; preset: string; focus: string[]; layers: Record<string, number>; zones: boolean }[];
  qrPath: string; // URL relatif halaman materi pasien
  exitHref: string;
}
const { title, scenes, qrPath, exitHref } = Astro.props;
const zones = (await getCollection('danger-zones')).map((z) => ({ slug: z.id, overlay: z.data.overlay }));
---
<div class="scene-player fixed inset-0 z-50 flex flex-col bg-bg lg:flex-row" data-player>
  <div
    class="relative min-h-0 flex-1"
    style="background: radial-gradient(80% 80% at 50% 45%, color-mix(in oklab, var(--brand) 14%, var(--bg)) 0%, var(--brand-soft) 60%, var(--surface) 100%);"
  >
    <div class="absolute inset-0 touch-none" data-canvas></div>
    <p class="absolute bottom-3 right-3 hidden items-center gap-2 rounded-lg bg-bg/90 px-3 py-1.5 text-xs font-medium shadow-sm [&:not(.hidden)]:inline-flex" data-loading>
      <span class="size-3 animate-spin rounded-full border-2 border-brand border-t-transparent motion-reduce:animate-none" aria-hidden="true"></span>
      Memuat model
    </p>
    <p class="absolute inset-0 m-auto hidden h-fit max-w-sm p-4 text-center text-sm text-muted" data-fallback>
      Browser ini tidak mendukung WebGL. Narasi tetap dapat dibaca di samping.
    </p>
  </div>

  <aside class="flex max-h-[48vh] flex-col border-t border-line bg-bg lg:max-h-none lg:w-[27rem] lg:border-l lg:border-t-0">
    <header class="flex items-center justify-between gap-3 border-b border-line px-4 py-3">
      <p class="truncate text-sm font-bold">{title}</p>
      <div class="flex shrink-0 gap-1">
        <button type="button" data-qr class="btn btn-quiet btn-sm" title="QR materi pasien">
          <Icon name="qr-code" size={16} /><span class="hidden sm:inline">QR materi</span>
        </button>
        <button type="button" data-fullscreen class="btn btn-quiet btn-sm" aria-label="Layar penuh" title="Layar penuh">
          <Icon name="corners-out" size={16} />
        </button>
        <a href={exitHref} class="btn btn-quiet btn-sm" aria-label="Keluar dari presentasi" title="Keluar">
          <Icon name="x" size={16} />
        </a>
      </div>
    </header>

    <div class="flex gap-1 px-5 pt-4" data-dots>
      {scenes.map((_, i) => (
        <button type="button" data-dot={i} aria-label={`Langkah ${i + 1}`}
          class="h-1.5 flex-1 rounded-full bg-line transition-colors duration-300 data-done:bg-brand"></button>
      ))}
    </div>

    <div class="min-h-0 flex-1 overflow-auto px-5 pb-4 pt-3" aria-live="polite">
      <p class="tabular text-xs font-semibold text-brand-ink" data-step-count></p>
      <h2 class="mt-1 text-2xl font-bold tracking-tight" data-step-title></h2>
      <p class="mt-3 text-lg leading-relaxed text-ink" data-step-text></p>
    </div>

    <footer class="flex items-center justify-between gap-2 border-t border-line px-4 py-3">
      <button type="button" data-prev class="btn btn-quiet"><Icon name="arrow-left" size={18} /> Sebelumnya</button>
      <button type="button" data-next class="btn btn-primary">Berikutnya <Icon name="arrow-right" size={18} weight="bold" /></button>
    </footer>
  </aside>

  <dialog class="m-auto w-[min(22rem,calc(100%-2rem))] rounded-2xl bg-bg p-6 text-center text-ink shadow-2xl backdrop:bg-ink/50" data-qr-dialog>
    <p class="text-lg font-bold">Materi untuk dibaca di rumah</p>
    <p class="mt-1 text-sm text-muted">Pindai dengan kamera ponsel.</p>
    <canvas class="mx-auto mt-5 rounded-xl bg-white p-2" data-qr-canvas></canvas>
    <p class="mt-3 break-all text-xs text-muted" data-qr-url></p>
    <form method="dialog" class="mt-5"><button class="btn btn-quiet w-full justify-center">Tutup</button></form>
  </dialog>
</div>

<script is:inline type="application/json" id="player-scenes" set:html={JSON.stringify(scenes)}></script>
<script is:inline type="application/json" id="player-zones" set:html={JSON.stringify(zones)}></script>
<script is:inline type="application/json" id="player-qr" set:html={JSON.stringify(qrPath)}></script>

<script>
  import QRCode from 'qrcode';
  import { AnatomyViewer, type SceneDef, type ZoneDef } from '../../lib/viewer/anatomy-viewer';

  type Scene = SceneDef & { title: string; narration: string };
  const root = document.querySelector<HTMLElement>('[data-player]')!;
  const q = <T extends Element = HTMLElement>(s: string) => root.querySelector<T>(s)!;
  const scenes: Scene[] = JSON.parse(document.getElementById('player-scenes')!.textContent!);
  const zones: ZoneDef[] = JSON.parse(document.getElementById('player-zones')!.textContent!);
  const qrUrl = new URL(JSON.parse(document.getElementById('player-qr')!.textContent!), location.origin).toString();

  let viewer: AnatomyViewer | null = null;
  if (AnatomyViewer.isSupported()) {
    viewer = new AnatomyViewer(q('[data-canvas]'));
    const loading = q('[data-loading]');
    let pending = 0;
    viewer.onLoading = (_, on) => {
      pending += on ? 1 : -1;
      loading.classList.toggle('hidden', pending <= 0);
    };
  } else {
    q('[data-fallback]').classList.remove('hidden');
  }

  let index = 0;
  const dots = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-dot]'));
  async function go(i: number) {
    index = Math.max(0, Math.min(scenes.length - 1, i));
    const s = scenes[index];
    q('[data-step-count]').textContent = `Langkah ${index + 1} dari ${scenes.length}`;
    q('[data-step-title]').textContent = s.title;
    q('[data-step-text]').textContent = s.narration;
    q<HTMLButtonElement>('[data-prev]').disabled = index === 0;
    q<HTMLButtonElement>('[data-next]').disabled = index === scenes.length - 1;
    dots.forEach((d, k) => {
      d.setAttribute('aria-current', k === index ? 'step' : 'false');
      d.toggleAttribute('data-done', k <= index);
    });
    await viewer?.applyScene(s, zones);
  }
  q('[data-prev]').addEventListener('click', () => go(index - 1));
  q('[data-next]').addEventListener('click', () => go(index + 1));
  dots.forEach((d) => d.addEventListener('click', () => go(Number(d.dataset.dot))));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowRight' || e.key === 'PageDown') go(index + 1);
    if (e.key === 'ArrowLeft' || e.key === 'PageUp') go(index - 1);
  });

  q('[data-fullscreen]').addEventListener('click', () => {
    if (document.fullscreenElement) document.exitFullscreen();
    else root.requestFullscreen?.().catch(() => {});
  });

  const dialog = q<HTMLDialogElement>('[data-qr-dialog]');
  q('[data-qr]').addEventListener('click', async () => {
    await QRCode.toCanvas(q<HTMLCanvasElement>('[data-qr-canvas]'), qrUrl, { width: 220, margin: 1 });
    q('[data-qr-url]').textContent = qrUrl;
    dialog.showModal();
  });

  if (viewer) viewer.init().then(() => go(0));
  else go(0);
</script>
