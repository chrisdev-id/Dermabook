---
// Fakta singkat sebuah prosedur untuk pasien: pemulihan, kapan hasil terlihat, berapa lama bertahan, dst.
import Icon from './Icon.astro';

interface Props {
  facts: {
    downtime?: string;
    onset?: string;
    duration?: string;
    sessions?: string;
    reversible?: string;
    skin_tone?: string;
  };
}
const { facts } = Astro.props;
const rows = [
  { key: 'downtime', label: 'Masa pemulihan', icon: 'bandaids' },
  { key: 'onset', label: 'Hasil terlihat', icon: 'eye' },
  { key: 'duration', label: 'Bertahan', icon: 'hourglass-medium' },
  { key: 'sessions', label: 'Jumlah sesi', icon: 'repeat' },
  { key: 'reversible', label: 'Bisa dibatalkan?', icon: 'arrow-counter-clockwise' },
  { key: 'skin_tone', label: 'Kulit sawo matang atau gelap', icon: 'palette' },
] as const;
const shown = rows.filter((r) => facts[r.key]);
---
{shown.length > 0 && (
  <section aria-labelledby="fakta-h">
    <h2 id="fakta-h" class="text-xl font-bold">Fakta singkat</h2>
    <dl class="mt-4 grid gap-px overflow-hidden rounded-2xl bg-line sm:grid-cols-2">
      {shown.map((r) => (
        <div class="bg-bg p-4 sm:p-5">
          <dt class="flex items-center gap-2.5 text-sm font-semibold text-muted">
            <Icon name={r.icon} size={22} class="shrink-0 text-brand" /> {r.label}
          </dt>
          <dd class="mt-1.5 pl-[2.0625rem]">{facts[r.key]}</dd>
        </div>
      ))}
    </dl>
  </section>
)}
