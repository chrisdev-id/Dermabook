---
import Base from '../../layouts/Base.astro';
import PageMeta from '../../components/PageMeta.astro';
import ReferenceList from '../../components/ReferenceList.astro';
import PatientInfo from '../../components/PatientInfo.astro';
import ClinicalGate from '../../components/ClinicalGate.astro';
import Icon from '../../components/Icon.astro';
import RiskBadge from '../../components/RiskBadge.astro';
import QuickFacts from '../../components/QuickFacts.astro';
import SkinDepth from '../../components/SkinDepth.astro';
import { getCollection, getEntries, render } from 'astro:content';

export async function getStaticPaths() {
  const procedures = await getCollection('procedures');
  return procedures.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
const structures = await getEntries(d.structures);
const zones = await getEntries(d.danger_zones);
const complications = (await getCollection('complications'))
  .filter((c) => c.data.related_procedures.some((p) => p.id === entry.id))
  .sort((a, b) => a.data.order - b.data.order);
---
<Base title={d.title} description={d.summary}>
  <a href="/prosedur/" class="back-link"><Icon name="arrow-left" size={16} /> Prosedur & konsep</a>
  <h1 class="page-title mt-4">{d.title}</h1>
  {d.aka.length > 0 && <p class="mt-2 text-sm text-muted">Dikenal juga sebagai {d.aka.join(', ')}</p>}
  <p class="lede mt-3">{d.summary}</p>
  <PageMeta status={d.status} reviewers={d.reviewers} filePath={entry.filePath} title={d.title} />

  <div class="no-print mt-7 flex flex-wrap items-center gap-3">
    {d.scenes.length > 0 && (
      <a href={`/presentasi/${entry.id}/`} class="btn btn-primary">
        <Icon name="play" size={18} weight="fill" /> Mulai presentasi
        <span class="font-medium opacity-80">{d.scenes.length} langkah</span>
      </a>
    )}
    <a href={`/materi/${entry.id}/`} class="btn btn-secondary">
      <Icon name="qr-code" size={18} /> Materi pasien, cetak dan QR
    </a>
  </div>

  {(d.quick_facts || d.depths.length > 0) && (
    <div class:list={['mt-10 grid gap-6', d.depths.length > 0 && 'lg:grid-cols-[1.6fr_1fr] lg:items-start']}>
      {d.quick_facts && <QuickFacts facts={d.quick_facts} />}
      {d.depths.length > 0 && <SkinDepth depths={d.depths} caption="Lapisan kulit yang dicapai (ilustrasi)" />}
    </div>
  )}

  {d.patient && <div class="mt-10"><PatientInfo patient={d.patient} /></div>}

  <ClinicalGate>
    <article class="prose-content mt-4">
      <Content />
    </article>

    {structures.length > 0 && (
      <section class="mt-12" aria-labelledby="anatomi-h">
        <h2 id="anatomi-h" class="text-lg font-bold">Anatomi terkait</h2>
        <ul class="mt-3 flex flex-wrap gap-2 text-sm">
          {structures.map((s) => (
            <li><a href={`/atlas/struktur/${s.id}/`} class="btn btn-quiet btn-sm">{s.data.name_id}</a></li>
          ))}
        </ul>
      </section>
    )}

    {zones.length > 0 && (
      <section class="mt-8" aria-labelledby="zona-h">
        <h2 id="zona-h" class="text-lg font-bold">Zona bahaya terkait</h2>
        <ul class="mt-3 flex flex-wrap gap-2 text-sm">
          {zones.map((z) => (
            <li>
              <a href={`/atlas/zona-bahaya/${z.id}/`} class="btn btn-sm bg-danger-soft text-danger hover:text-danger">
                <Icon name="warning-octagon" size={14} /> {z.data.name}
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}

    {complications.length > 0 && (
      <section class="mt-8" aria-labelledby="komplikasi-h">
        <h2 id="komplikasi-h" class="text-lg font-bold">Komplikasi yang perlu dipahami</h2>
        <ul class="mt-3 divide-y divide-line border-y border-line">
          {complications.map((c) => (
            <li>
              <a href={`/komplikasi/${c.id}/`} class="group flex flex-wrap items-center gap-x-4 gap-y-1 py-3 font-medium text-ink no-underline">
                <span class="flex-1 group-hover:text-brand-ink">{c.data.title}</span>
                <RiskBadge serious={c.data.severity === 'serius'} />
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}
  </ClinicalGate>

  <ReferenceList refs={d.refs} />
</Base>
