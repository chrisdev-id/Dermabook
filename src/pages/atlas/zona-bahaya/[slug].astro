---
import Base from '../../../layouts/Base.astro';
import PageMeta from '../../../components/PageMeta.astro';
import ReferenceList from '../../../components/ReferenceList.astro';
import Icon from '../../../components/Icon.astro';
import RiskBadge from '../../../components/RiskBadge.astro';
import { getCollection, getEntries, render } from 'astro:content';

export async function getStaticPaths() {
  const zones = await getCollection('danger-zones');
  return zones.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
const structures = await getEntries(d.structures);
---
<Base title={`Zona bahaya: ${d.name}`} description={d.summary}>
  <a href="/atlas/zona-bahaya/" class="back-link"><Icon name="arrow-left" size={16} /> Semua zona bahaya</a>
  <p class="mt-5"><RiskBadge level={d.risk_level} /></p>
  <h1 class="page-title mt-3">{d.name}</h1>
  <p class="lede mt-3">{d.summary}</p>
  <PageMeta status={d.status} reviewers={d.reviewers} filePath={entry.filePath} title={d.name} />

  <div class="no-print mt-6">
    <a href={`/atlas/?zona=${entry.id}`} class="btn btn-secondary">
      <Icon name="cube-transparent" size={18} /> Lihat zona di model 3D
    </a>
  </div>

  <article class="prose-content mt-10">
    <Content />
  </article>

  <p class="mt-8 flex max-w-[70ch] gap-3 rounded-2xl bg-surface p-5 text-sm text-muted">
    <Icon name="info" size={20} class="mt-0.5 shrink-0 text-brand" />
    <span>
      Materi ini menjelaskan anatomi untuk pembelajaran. Letak pembuluh darah berbeda pada tiap orang, jadi lokasi di
      model 3D hanya ilustrasi. Halaman ini bukan panduan teknik atau penanganan komplikasi; untuk itu, gunakan
      pedoman lengkap di daftar referensi.
    </span>
  </p>

  {structures.length > 0 && (
    <section class="mt-10" aria-labelledby="terkait-h">
      <h2 id="terkait-h" class="text-lg font-bold">Struktur terkait</h2>
      <ul class="mt-3 flex flex-wrap gap-2 text-sm">
        {structures.map((s) => (
          <li><a href={`/atlas/struktur/${s.id}/`} class="btn btn-quiet btn-sm">{s.data.name_id}</a></li>
        ))}
      </ul>
    </section>
  )}

  <ReferenceList refs={d.refs} />
</Base>
