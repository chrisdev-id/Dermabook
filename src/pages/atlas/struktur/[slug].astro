---
import Base from '../../../layouts/Base.astro';
import PageMeta from '../../../components/PageMeta.astro';
import ReferenceList from '../../../components/ReferenceList.astro';
import Icon from '../../../components/Icon.astro';
import { getCollection, render } from 'astro:content';
import { LAYERS } from '../../../lib/viewer/layers';
import { relevanceLabel } from '../../../lib/taxonomy';

export async function getStaticPaths() {
  const structures = await getCollection('structures');
  return structures.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
const layer = LAYERS.find((l) => l.key === d.layer)!;
const zones = (await getCollection('danger-zones')).filter((z) => z.data.structures.some((s) => s.id === entry.id));
---
<Base title={d.name_id} description={d.summary}>
  <a href="/atlas/struktur/" class="back-link"><Icon name="arrow-left" size={16} /> Semua struktur</a>
  <p class="mt-5 flex flex-wrap items-center gap-2 text-sm font-medium text-muted">
    <span class="inline-block size-3 rounded-[4px]" style={`background:${layer.color}`} aria-hidden="true"></span>
    {layer.label}
    {d.schematic && <span class="chip">Ilustrasi skematik</span>}
  </p>
  <h1 class="page-title mt-2">{d.name_id}</h1>
  <p class="mt-1 text-sm text-muted"><em>{d.name_latin}</em>, {d.name_en}</p>
  <p class="lede mt-4">{d.summary}</p>
  <PageMeta status={d.status} reviewers={d.reviewers} filePath={entry.filePath} title={d.name_id} />

  <div class="no-print mt-6 flex flex-wrap items-center gap-2">
    <a href={`/atlas/?fokus=${entry.id}`} class="btn btn-secondary">
      <Icon name="cube-transparent" size={18} /> Lihat di model 3D
    </a>
    {d.relevance.map((r) => <span class="chip">Terkait: {relevanceLabel[r]}</span>)}
  </div>

  <article class="prose-content mt-10">
    <Content />
  </article>

  {zones.length > 0 && (
    <section class="mt-10 max-w-[70ch] rounded-2xl border-l-4 border-danger bg-danger-soft p-5" aria-labelledby="zona-h">
      <h2 id="zona-h" class="flex items-center gap-2 font-bold text-danger">
        <Icon name="warning-octagon" size={20} weight="bold" /> Terkait zona bahaya
      </h2>
      <ul class="mt-3 flex flex-wrap gap-x-5 gap-y-2 font-medium">
        {zones.map((z) => <li><a href={`/atlas/zona-bahaya/${z.id}/`}>{z.data.name}</a></li>)}
      </ul>
    </section>
  )}

  <ReferenceList refs={d.refs} />
</Base>
