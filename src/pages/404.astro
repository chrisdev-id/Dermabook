---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
---
<Base title="Halaman tidak ditemukan" noindex>
  <div class="mx-auto max-w-xl py-16 text-center">
    <p class="tabular text-6xl font-bold tracking-tight text-brand">404</p>
    <h1 class="page-title mt-4">Halaman tidak ditemukan</h1>
    <p class="mt-3 text-muted">Halaman yang Anda cari tidak ada atau sudah dipindahkan.</p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a href="/" class="btn btn-secondary"><Icon name="house" size={18} /> Beranda</a>
      <a href="/atlas/" class="btn btn-quiet"><Icon name="cube-transparent" size={18} /> Anatomi Wajah 3D</a>
    </div>
  </div>
</Base>
